---
import AppLayout from '../layouts/AppLayout.astro'
import AccountsApp from '../components/AccountsApp'

const connected = Astro.url.searchParams.get('connected')
const connectError = Astro.url.searchParams.get('error')
---
<AppLayout title="Accounts">
  <AccountsApp client:only="react" connected={connected} connectError={connectError} />
</AppLayout>
