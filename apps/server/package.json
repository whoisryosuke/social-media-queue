{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "tsx watch src/api/serve.ts",
    "start:api:prod": "node dist/api/serve.js",
    "start:worker": "tsx watch src/worker/run.ts",
    "start:worker:prod": "node dist/worker/run.js",
    "test": "vitest run --passWithNoTests --fileParallelism=false",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.24.0",
    "@atproto/common-web": "^0.5.14",
    "@hono/node-server": "^1.13.2",
    "@social-scheduler/shared": "workspace:^",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.5.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3"
  }
}
