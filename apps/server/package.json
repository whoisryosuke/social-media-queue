{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "tsx watch src/api/serve.ts",
    "start:api:prod": "node dist/api/serve.js",
    "start:worker": "tsx watch src/worker/run.ts",
    "start:worker:prod": "node dist/worker/run.js",
    "test": "vitest run",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.2",
    "dotenv": "^16.4.5",
    "hono": "^4.5.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3"
  }
}
