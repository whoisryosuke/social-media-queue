{
  "name": "social-scheduler",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api,worker -c green,blue,magenta \"pnpm --filter web dev\" \"pnpm --filter server start:api\" \"pnpm --filter server start:worker\"",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "gen:key": "node scripts/gen-key.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.18.0"
  }
}
